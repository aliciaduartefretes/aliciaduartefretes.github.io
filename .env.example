# La facturación queda cerrada por defecto. Valores válidos: disabled, test, live.
NALVI_BILLING_MODE=disabled
NALVI_PUBLIC_APP_URL=https://www.idiomaguarani.com.py
NALVI_ALLOWED_ORIGINS=https://www.idiomaguarani.com.py,https://idiomaguarani.com.py

# Configurar únicamente como variables Secret en Vercel. No pegar valores reales aquí.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# Ejemplo de formato. Los IDs reales deben venir del panel de Lemon Squeezy.
# LEMONSQUEEZY_PLAN_CATALOG_JSON={"nalvi_plus_monthly":{"kind":"subscription","variantId":"123","productId":"456","entitlements":["courses:premium"],"displayName":"NALVI Plus","description":"Acceso a cursos premium","priceLabel":"USD 9/mes"}}
LEMONSQUEEZY_PLAN_CATALOG_JSON=

# Solo para activar cobros reales después de una autorización explícita.
NALVI_BILLING_LIVE_CONFIRMATION=
