{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/generate-reinforcement-activity.js": {
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/api/generate-reinforcement-activity",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
