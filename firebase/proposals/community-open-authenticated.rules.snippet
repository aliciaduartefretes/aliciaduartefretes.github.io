// COMUNIDAD NALVI. Esta sección se inserta antes del cierre fail-closed.
// Cualquier visitante puede leer la Comunidad. Solo una cuenta real de NALVI
// (no una sesión anónima) puede publicar, responder, reaccionar o registrar vista.

function isCommunityMember() {
  return signedIn()
    && request.auth.token.firebase.sign_in_provider != 'anonymous';
}

function communityName() {
  return isCommunityMember()
    ? request.auth.token.get('name', '')
    : '';
}

function communityPhoto() {
  return isCommunityMember()
    ? request.auth.token.get('picture', '')
    : '';
}

function validCommunityCategory(value) {
  return value is string
    && value in ['announcements', 'questions', 'community', 'learning', 'resources'];
}

function validCommunityText(value, maximum) {
  return value is string && value.size() >= 1 && value.size() <= maximum;
}

function validCommunityPhoto(value) {
  return value is string
    && value.size() <= 500
    && value == communityPhoto();
}

function validCommunityMediaPath(value, userId, scope) {
  return value is string
    && (
      value == ''
      || value.matches('^communityMedia/' + userId + '/' + scope + '/[A-Za-z0-9_-]{1,80}$')
    );
}

function validCommunityUrl(value) {
  return value is string
    && value.size() <= 500
    && (value == '' || value.matches('^https://[^\\s]+$'));
}

match /communityProfiles/{userId} {
  allow get, list: if true;

  allow create: if isCommunityMember()
    && userId == request.auth.uid
    && request.resource.data.keys().hasOnly([
      'userId', 'displayName', 'photoURL', 'avatarPath', 'coverPath',
      'bio', 'createdAt', 'updatedAt'
    ])
    && request.resource.data.keys().hasAll([
      'userId', 'displayName', 'photoURL', 'bio', 'createdAt', 'updatedAt'
    ])
    && request.resource.data.userId == request.auth.uid
    && validCommunityText(request.resource.data.displayName, 80)
    && request.resource.data.displayName == communityName()
    && validCommunityPhoto(request.resource.data.photoURL)
    && validCommunityMediaPath(request.resource.data.get('avatarPath', ''), userId, 'profile')
    && validCommunityMediaPath(request.resource.data.get('coverPath', ''), userId, 'profile')
    && request.resource.data.bio is string
    && request.resource.data.bio.size() <= 160
    && request.resource.data.createdAt == request.time
    && request.resource.data.updatedAt == request.time;

  allow update: if isCommunityMember()
    && userId == request.auth.uid
    && resource.data.userId == request.auth.uid
    && request.resource.data.userId == resource.data.userId
    && request.resource.data.createdAt == resource.data.createdAt
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
      'displayName', 'photoURL', 'avatarPath', 'coverPath', 'bio', 'updatedAt'
    ])
    && validCommunityText(request.resource.data.displayName, 80)
    && request.resource.data.displayName == communityName()
    && validCommunityPhoto(request.resource.data.photoURL)
    && validCommunityMediaPath(request.resource.data.get('avatarPath', ''), userId, 'profile')
    && validCommunityMediaPath(request.resource.data.get('coverPath', ''), userId, 'profile')
    && request.resource.data.bio is string
    && request.resource.data.bio.size() <= 160
    && request.resource.data.updatedAt == request.time;

  allow delete: if isPlatformAdmin();

  match /followers/{followerId} {
    allow get, list: if true;
    allow create: if isCommunityMember()
      && followerId == request.auth.uid
      && userId != request.auth.uid
      && exists(/databases/$(database)/documents/communityProfiles/$(userId))
      && request.resource.data.keys().hasOnly(['createdAt'])
      && request.resource.data.keys().hasAll(['createdAt'])
      && request.resource.data.createdAt == request.time;
    allow update: if false;
    allow delete: if isCommunityMember() && followerId == request.auth.uid;
    allow delete: if isPlatformAdmin();
  }
}

match /communityPosts/{postId} {
  allow get, list: if true;

  allow create: if isCommunityMember()
    && request.resource.data.keys().hasOnly([
      'authorId', 'authorName', 'body', 'category', 'pinned',
      'mediaPath', 'mediaType', 'resourceTitle', 'resourceUrl',
      'createdAt', 'updatedAt'
    ])
    && request.resource.data.keys().hasAll([
      'authorId', 'authorName', 'body', 'category', 'pinned', 'createdAt', 'updatedAt'
    ])
    && request.resource.data.authorId == request.auth.uid
    && validCommunityText(request.resource.data.authorName, 80)
    && request.resource.data.authorName == communityName()
    && validCommunityText(request.resource.data.body, 700)
    && validCommunityCategory(request.resource.data.category)
    && validCommunityMediaPath(request.resource.data.get('mediaPath', ''), request.auth.uid, 'posts')
    && request.resource.data.get('mediaType', '') in ['', 'image']
    && request.resource.data.get('resourceTitle', '') is string
    && request.resource.data.get('resourceTitle', '').size() <= 100
    && validCommunityUrl(request.resource.data.get('resourceUrl', ''))
    && (
      request.resource.data.category == 'resources'
      || (
        request.resource.data.get('resourceTitle', '') == ''
        && request.resource.data.get('resourceUrl', '') == ''
      )
    )
    && (
      request.resource.data.category != 'announcements'
      || isPlatformAdmin()
    )
    && request.resource.data.pinned == false
    && request.resource.data.createdAt == request.time
    && request.resource.data.updatedAt == request.time;

  allow update: if isCommunityMember()
    && resource.data.authorId == request.auth.uid
    && request.resource.data.authorId == resource.data.authorId
    && request.resource.data.authorName == resource.data.authorName
    && request.resource.data.createdAt == resource.data.createdAt
    && request.resource.data.pinned == resource.data.pinned
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
      'body', 'category', 'updatedAt'
    ])
    && validCommunityText(request.resource.data.body, 700)
    && validCommunityCategory(request.resource.data.category)
    && request.resource.data.category != 'announcements'
    && request.resource.data.updatedAt == request.time;

  allow delete: if isCommunityMember()
    && resource.data.authorId == request.auth.uid;
  allow delete: if isPlatformAdmin();

  match /comments/{commentId} {
    allow get, list: if true;
    allow create: if isCommunityMember()
      && request.resource.data.keys().hasOnly([
        'authorId', 'authorName', 'body', 'parentCommentId', 'createdAt', 'updatedAt'
      ])
      && request.resource.data.keys().hasAll([
        'authorId', 'authorName', 'body', 'parentCommentId', 'createdAt', 'updatedAt'
      ])
      && request.resource.data.authorId == request.auth.uid
      && validCommunityText(request.resource.data.authorName, 80)
      && request.resource.data.authorName == communityName()
      && validCommunityText(request.resource.data.body, 500)
      && request.resource.data.parentCommentId is string
      && request.resource.data.parentCommentId.size() <= 120
      && request.resource.data.createdAt == request.time
      && request.resource.data.updatedAt == request.time;
    allow update: if isCommunityMember()
      && resource.data.authorId == request.auth.uid
      && request.resource.data.authorId == resource.data.authorId
      && request.resource.data.authorName == resource.data.authorName
      && request.resource.data.parentCommentId == resource.data.parentCommentId
      && request.resource.data.createdAt == resource.data.createdAt
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'body', 'updatedAt'
      ])
      && validCommunityText(request.resource.data.body, 500)
      && request.resource.data.updatedAt == request.time;
    allow delete: if isCommunityMember()
      && resource.data.authorId == request.auth.uid;
    allow delete: if isPlatformAdmin();
  }

  match /reactions/{userId} {
    allow get, list: if true;
    allow create: if isCommunityMember()
      && userId == request.auth.uid
      && request.resource.data.keys().hasOnly(['type', 'createdAt'])
      && request.resource.data.keys().hasAll(['type', 'createdAt'])
      && request.resource.data.type == 'like'
      && request.resource.data.createdAt == request.time;
    allow update: if false;
    allow delete: if isCommunityMember() && userId == request.auth.uid;
    allow delete: if isPlatformAdmin();
  }

  match /views/{userId} {
    allow get, list: if true;
    allow create: if isCommunityMember()
      && userId == request.auth.uid
      && request.resource.data.keys().hasOnly(['createdAt'])
      && request.resource.data.keys().hasAll(['createdAt'])
      && request.resource.data.createdAt == request.time;
    allow update: if false;
    allow delete: if isPlatformAdmin();
  }
}
