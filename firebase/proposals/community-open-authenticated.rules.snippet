// PROPUESTA NO ACTIVA. No desplegar hasta completar la prueba de escritura real.
// Insertar dentro de /databases/{database}/documents, inmediatamente antes del
// catch-all `match /{document=**}` de firestore-PASO-6.rules.
//
// Comunidad abierta significa: cualquier cuenta autenticada de NALVI puede leer
// y participar. Los visitantes sin sesión no pueden leer ni escribir.

function validCommunityCategory(value) {
  return value is string
    && value in ['announcements', 'questions', 'community', 'resources'];
}

function validCommunityText(value, maximum) {
  return value is string && value.size() >= 1 && value.size() <= maximum;
}

match /communityPosts/{postId} {
  allow get, list: if signedIn();

  allow create: if signedIn()
    && request.resource.data.keys().hasOnly([
      'authorId', 'body', 'category', 'pinned', 'createdAt', 'updatedAt',
      'courseId', 'lessonId', 'assignmentId', 'groupId'
    ])
    && request.resource.data.keys().hasAll([
      'authorId', 'body', 'category', 'pinned', 'createdAt', 'updatedAt'
    ])
    && request.resource.data.authorId == request.auth.uid
    && validCommunityText(request.resource.data.body, 700)
    && validCommunityCategory(request.resource.data.category)
    && request.resource.data.pinned == false
    && request.resource.data.createdAt == request.time
    && request.resource.data.updatedAt == request.time
    && request.resource.data.get('courseId', '') is string
    && request.resource.data.get('lessonId', '') is string
    && request.resource.data.get('assignmentId', '') is string
    && request.resource.data.get('groupId', '') is string;

  allow update: if signedIn()
    && resource.data.authorId == request.auth.uid
    && request.resource.data.authorId == resource.data.authorId
    && request.resource.data.createdAt == resource.data.createdAt
    && request.resource.data.pinned == resource.data.pinned
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
      'body', 'category', 'updatedAt', 'courseId', 'lessonId',
      'assignmentId', 'groupId'
    ])
    && validCommunityText(request.resource.data.body, 700)
    && validCommunityCategory(request.resource.data.category)
    && request.resource.data.updatedAt == request.time
    && request.resource.data.get('courseId', '') is string
    && request.resource.data.get('lessonId', '') is string
    && request.resource.data.get('assignmentId', '') is string
    && request.resource.data.get('groupId', '') is string;

  allow delete: if signedIn()
    && resource.data.authorId == request.auth.uid;

  match /comments/{commentId} {
    allow get, list: if signedIn();
    allow create: if signedIn()
      && request.resource.data.keys().hasOnly([
        'authorId', 'body', 'parentCommentId', 'createdAt', 'updatedAt'
      ])
      && request.resource.data.keys().hasAll([
        'authorId', 'body', 'createdAt', 'updatedAt'
      ])
      && request.resource.data.authorId == request.auth.uid
      && validCommunityText(request.resource.data.body, 500)
      && request.resource.data.get('parentCommentId', '') is string
      && request.resource.data.createdAt == request.time
      && request.resource.data.updatedAt == request.time;
    allow update: if signedIn()
      && resource.data.authorId == request.auth.uid
      && request.resource.data.authorId == resource.data.authorId
      && request.resource.data.createdAt == resource.data.createdAt
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'body', 'updatedAt'
      ])
      && validCommunityText(request.resource.data.body, 500)
      && request.resource.data.updatedAt == request.time;
    allow delete: if signedIn()
      && resource.data.authorId == request.auth.uid;
  }

  match /reactions/{userId} {
    allow get, list: if signedIn();
    allow create, update: if signedIn()
      && userId == request.auth.uid
      && request.resource.data.keys().hasOnly(['authorId', 'type', 'updatedAt'])
      && request.resource.data.keys().hasAll(['authorId', 'type', 'updatedAt'])
      && request.resource.data.authorId == request.auth.uid
      && request.resource.data.type in ['like']
      && request.resource.data.updatedAt == request.time;
    allow delete: if signedIn() && userId == request.auth.uid;
  }
}
