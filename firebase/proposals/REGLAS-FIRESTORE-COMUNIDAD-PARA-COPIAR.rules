rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // GCA-GESA-01: reglas de prueba. Probar primero en Emulator Suite.

    function signedIn() {
      return request.auth != null;
    }

    function signedInNonAnonymous() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function matchesAuthenticatedName(value, fallback) {
      return value is string
        && value.size() >= 2
        && value.size() <= 120
        && (
          (
            request.auth.token.get('name', '') is string
            && request.auth.token.get('name', '').size() >= 2
            && request.auth.token.get('name', '').size() <= 120
            && value == request.auth.token.get('name', '')
          )
          || (
            request.auth.token.get('name', '').size() < 2
            && value == fallback
          )
        );
    }

    function email() {
      return signedIn()
        ? request.auth.token.get('email', '').lower()
        : '';
    }

    function sameEmail(value) {
      return signedIn() && value is string && value.lower() == email();
    }

    function staffPath() {
      return /databases/$(database)/documents/staff/$(email());
    }

    function hasActiveStaff() {
      return signedIn()
        && email() != ''
        && exists(staffPath())
        && get(staffPath()).data.get('active', false) == true;
    }

    function isPlatformAdmin() {
      return hasActiveStaff()
        && get(staffPath()).data.get('role', '') == 'admin';
    }

    function uidMembershipPath(institutionId) {
      return /databases/$(database)/documents/institutionMembers/$(institutionId + '__' + request.auth.uid);
    }

    function inviteMembershipPath(institutionId) {
      return /databases/$(database)/documents/institutionMembers/$(institutionId + '__invite__' + email());
    }

    function hasUidMembership(institutionId) {
      return signedIn()
        && institutionId is string
        && institutionId != ''
        && exists(uidMembershipPath(institutionId))
        && get(uidMembershipPath(institutionId)).data.get('active', false) == true;
    }

    function hasInviteMembership(institutionId) {
      return signedIn()
        && email() != ''
        && institutionId is string
        && institutionId != ''
        && exists(inviteMembershipPath(institutionId))
        && get(inviteMembershipPath(institutionId)).data.get('active', false) == true;
    }

    function isInstitutionMember(institutionId) {
      return isPlatformAdmin()
        || hasUidMembership(institutionId)
        || hasInviteMembership(institutionId)
        || (
          hasActiveStaff()
          && get(staffPath()).data.get('institutionId', '') == institutionId
        );
    }

    function uidMembershipHasRole(institutionId, role) {
      return hasUidMembership(institutionId)
        && get(uidMembershipPath(institutionId)).data.get('role', '') == role;
    }

    function inviteMembershipHasRole(institutionId, role) {
      return hasInviteMembership(institutionId)
        && get(inviteMembershipPath(institutionId)).data.get('role', '') == role;
    }

    function isInstitutionManager(institutionId) {
      return isPlatformAdmin()
        || (
          hasUidMembership(institutionId)
          && get(uidMembershipPath(institutionId)).data.get('role', '') == 'institution_manager'
        )
        || (
          hasInviteMembership(institutionId)
          && get(inviteMembershipPath(institutionId)).data.get('role', '') == 'institution_manager'
        );
    }

    function isInstitutionTeacher(institutionId) {
      return isPlatformAdmin()
        || (
          hasUidMembership(institutionId)
          && get(uidMembershipPath(institutionId)).data.get('role', '') == 'teacher'
        )
        || (
          hasInviteMembership(institutionId)
          && get(inviteMembershipPath(institutionId)).data.get('role', '') == 'teacher'
        )
        || (
          hasActiveStaff()
          && get(staffPath()).data.get('role', '') == 'teacher'
          && get(staffPath()).data.get('institutionId', '') == institutionId
        );
    }

    function canTeach(institutionId) {
      return isPlatformAdmin()
        || (
          hasUidMembership(institutionId)
          && get(uidMembershipPath(institutionId)).data.get('role', '')
            in ['institution_manager', 'teacher']
        )
        || (
          hasInviteMembership(institutionId)
          && get(inviteMembershipPath(institutionId)).data.get('role', '')
            in ['institution_manager', 'teacher']
        )
        || (
          hasActiveStaff()
          && get(staffPath()).data.get('role', '') == 'teacher'
          && get(staffPath()).data.get('institutionId', '') == institutionId
        );
    }

    function isLegacyTeacherRecord(data) {
      return hasActiveStaff()
        && data.get('institutionId', '') == ''
        && (
          isPlatformAdmin()
          || data.get('teacherId', '') == request.auth.uid
          || data.get('teacherUid', '') == request.auth.uid
          || sameEmail(data.get('teacherEmail', ''))
          || sameEmail(data.get('ownerTeacherEmail', ''))
          || (
            data.get('coTeacherEmails', []) is list
            && email() in data.get('coTeacherEmails', [])
          )
        );
    }

    function isOwnStudentData(data) {
      return signedIn()
        && (
          data.get('studentId', '') == request.auth.uid
          || data.get('studentUid', '') == request.auth.uid
          || sameEmail(data.get('studentEmail', ''))
        );
    }

    function enrollmentPath(groupId, studentEmail) {
      return /databases/$(database)/documents/enrollments/$(groupId + '__' + studentEmail);
    }

    function groupInvitePath(code) {
      return /databases/$(database)/documents/courseAccess/$('code__' + code);
    }

    function institutionJoinPath(code) {
      return /databases/$(database)/documents/institutionJoinCodes/$('code__' + code);
    }

    function hasValidInstitutionJoinCode(code, institutionId) {
      return signedIn()
        && code is string
        && code.matches('^GCI-[A-Z0-9]{6}$')
        && exists(institutionJoinPath(code))
        && get(institutionJoinPath(code)).data.get('type', '') == 'institution_teacher_invite'
        && get(institutionJoinPath(code)).data.get('code', '') == code
        && get(institutionJoinPath(code)).data.get('institutionId', '') == institutionId
        && get(institutionJoinPath(code)).data.get('active', false) == true
        && exists(/databases/$(database)/documents/institutions/$(institutionId))
        && get(/databases/$(database)/documents/institutions/$(institutionId)).data.get('active', false) == true
        && get(/databases/$(database)/documents/institutions/$(institutionId)).data.get('status', '') != 'suspended'
        && get(/databases/$(database)/documents/institutions/$(institutionId)).data.get('selfService', false) != true;
    }

    function isEnrolledIn(groupId) {
      return signedIn()
        && email() != ''
        && groupId is string
        && groupId != ''
        && exists(enrollmentPath(groupId, email()))
        && get(enrollmentPath(groupId, email())).data.get('active', false) != false
        && sameEmail(get(enrollmentPath(groupId, email())).data.get('studentEmail', ''));
    }

    function hasActiveAcademicEnrollment(groupId, institutionId) {
      return signedInNonAnonymous()
        && email() != ''
        && groupId is string
        && groupId != ''
        && institutionId is string
        && institutionId != ''
        && exists(enrollmentPath(groupId, email()))
        && get(enrollmentPath(groupId, email())).data.get('active', false) == true
        && get(enrollmentPath(groupId, email())).data.get('groupId', '') == groupId
        && get(enrollmentPath(groupId, email())).data.get('institutionId', '') == institutionId
        && sameEmail(get(enrollmentPath(groupId, email())).data.get('studentEmail', ''));
    }

    function readsOwnUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function selfInstitutionId() {
      return signedIn() ? 'self__' + request.auth.uid : '';
    }

    function isOwnSelfInstitution(institutionId) {
      return signedIn()
        && email() != ''
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && institutionId == selfInstitutionId();
    }

    function ownsSelfInstitution(institutionId) {
      return isOwnSelfInstitution(institutionId)
        && exists(/databases/$(database)/documents/institutions/$(institutionId))
        && get(/databases/$(database)/documents/institutions/$(institutionId)).data.get('ownerUid', '') == request.auth.uid
        && get(/databases/$(database)/documents/institutions/$(institutionId)).data.get('active', false) == true;
    }

    function institutionPath(institutionId) {
      return /databases/$(database)/documents/institutions/$(institutionId);
    }

    function groupPath(groupId) {
      return /databases/$(database)/documents/groups/$(groupId);
    }

    function isOrganizationInstitution(institutionId) {
      return signedInNonAnonymous()
        && institutionId is string
        && institutionId != ''
        && exists(institutionPath(institutionId))
        && get(institutionPath(institutionId)).data.get('active', false) == true
        && get(institutionPath(institutionId)).data.get('status', '') != 'suspended'
        && get(institutionPath(institutionId)).data.get('selfService', false) != true;
    }

    function hasActiveAcademicRole(institutionId, roles) {
      return signedInNonAnonymous()
        && institutionId is string
        && institutionId != ''
        && exists(uidMembershipPath(institutionId))
        && get(uidMembershipPath(institutionId)).data.get('active', false) == true
        && get(uidMembershipPath(institutionId)).data.get('role', '') in roles;
    }

    function isAcademicTeacher(institutionId) {
      return isPlatformAdmin()
        || hasActiveAcademicRole(
          institutionId,
          ['institution_manager', 'teacher']
        );
    }

    function isAcademicManager(institutionId) {
      return isPlatformAdmin()
        || hasActiveAcademicRole(institutionId, ['institution_manager']);
    }

    function isInstitutionStudent(institutionId) {
      return hasActiveAcademicRole(institutionId, ['student']);
    }

    function canManageAcademicGroup(groupId, institutionId) {
      return signedInNonAnonymous()
        && groupId is string
        && groupId != ''
        && exists(groupPath(groupId))
        && get(groupPath(groupId)).data.get('institutionId', '') == institutionId
        && (
          isPlatformAdmin()
          || isAcademicManager(institutionId)
          || (
            isAcademicTeacher(institutionId)
            && (
              get(groupPath(groupId)).data.get('teacherId', '') == request.auth.uid
              || get(groupPath(groupId)).data.get('teacherUid', '') == request.auth.uid
              || get(groupPath(groupId)).data.get('ownerTeacherUid', '') == request.auth.uid
              || sameEmail(get(groupPath(groupId)).data.get('teacherEmail', ''))
              || sameEmail(get(groupPath(groupId)).data.get('ownerTeacherEmail', ''))
              || (
                get(groupPath(groupId)).data.get('coTeacherEmails', []) is list
                && email() in get(groupPath(groupId)).data.get('coTeacherEmails', [])
              )
            )
          )
        );
    }

    function academicPostPath(postId) {
      return /databases/$(database)/documents/academicPosts/$(postId);
    }

    function teacherTaskTemplatePath(templateId) {
      return /databases/$(database)/documents/teacherTaskTemplates/$(templateId);
    }

    function teacherTaskAssignmentPath(assignmentId) {
      return /databases/$(database)/documents/teacherTaskAssignments/$(assignmentId);
    }

    function validOwnTaskSubmission(submissionId, data) {
      return signedInNonAnonymous()
        && data.get('assignmentId', '') is string
        && data.get('assignmentId', '') != ''
        && submissionId == data.get('assignmentId', '') + '__' + request.auth.uid
        && data.get('studentId', '') == request.auth.uid
        && matchesAuthenticatedName(data.get('studentName', ''), 'Estudiante')
        && exists(teacherTaskAssignmentPath(data.get('assignmentId', '')))
        && get(teacherTaskAssignmentPath(data.get('assignmentId', ''))).data.get('institutionId', '')
          == data.get('institutionId', '')
        && get(teacherTaskAssignmentPath(data.get('assignmentId', ''))).data.get('groupId', '')
          == data.get('groupId', '')
        && hasActiveAcademicEnrollment(
          data.get('groupId', ''),
          data.get('institutionId', '')
        );
    }

    function canReadTeacherTaskTemplate(data) {
      return signedInNonAnonymous()
        && (
          isPlatformAdmin()
          || data.get('ownerUid', '') == request.auth.uid
          || isAcademicManager(data.get('institutionId', ''))
        );
    }

    function validOwnAcademicAuthorship(data) {
      return signedInNonAnonymous()
        && data.get('authorId', '') == request.auth.uid
        && matchesAuthenticatedName(data.get('authorName', ''), 'Usuario NALVI');
    }

    function validAcademicPostScope(data) {
      return data.get('institutionId', '') is string
        && data.get('institutionId', '') != ''
        && data.get('audience', '') in ['class', 'institution']
        && (
          (
            data.get('audience', '') == 'class'
            && canManageAcademicGroup(
              data.get('groupId', ''),
              data.get('institutionId', '')
            )
          )
          || (
            data.get('audience', '') == 'institution'
            && data.get('groupId', '') == ''
            && isOrganizationInstitution(data.get('institutionId', ''))
            && isAcademicTeacher(data.get('institutionId', ''))
          )
        );
    }

    function canReadAcademicPost(data) {
      return signedInNonAnonymous()
        && (
          isPlatformAdmin()
          || (
            data.get('audience', '') == 'institution'
            && isOrganizationInstitution(data.get('institutionId', ''))
            && (
              isAcademicTeacher(data.get('institutionId', ''))
              || isInstitutionStudent(data.get('institutionId', ''))
            )
          )
          || (
            data.get('audience', '') == 'class'
            && exists(groupPath(data.get('groupId', '')))
            && get(groupPath(data.get('groupId', ''))).data.get('institutionId', '')
              == data.get('institutionId', '')
            && (
              canManageAcademicGroup(
                data.get('groupId', ''),
                data.get('institutionId', '')
              )
              || hasActiveAcademicEnrollment(
                data.get('groupId', ''),
                data.get('institutionId', '')
              )
            )
          )
        );
    }

    function canModerateAcademicPost(postId) {
      return exists(academicPostPath(postId))
        && canReadAcademicPost(get(academicPostPath(postId)).data)
        && (
          isPlatformAdmin()
          || get(academicPostPath(postId)).data.get('authorId', '') == request.auth.uid
          || isAcademicManager(
            get(academicPostPath(postId)).data.get('institutionId', '')
          )
        );
    }

    function userProfilePath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function selfProfileRoleIsTrusted(data) {
      return data.get('role', 'student') == 'student'
        || (
          data.get('role', '') == 'platform_admin'
          && isPlatformAdmin()
        )
        || (
          data.get('role', '') == 'institution_manager'
          && isInstitutionManager(data.get('primaryInstitutionId', ''))
        )
        || (
          data.get('role', '') == 'teacher'
          && canTeach(data.get('primaryInstitutionId', ''))
        );
    }

    function canReadPedagogicalUser(userId) {
      return readsOwnUser(userId)
        || isPlatformAdmin()
        || (
          exists(userProfilePath(userId))
          && get(userProfilePath(userId)).data.get('primaryInstitutionId', '') != ''
          && canTeach(get(userProfilePath(userId)).data.get('primaryInstitutionId', ''))
        )
        || (
          exists(userProfilePath(userId))
          && hasActiveStaff()
          && get(userProfilePath(userId)).data.get('teacherEmails', []) is list
          && email() in get(userProfilePath(userId)).data.get('teacherEmails', [])
        );
    }

    match /users/{userId} {
      allow get, list: if readsOwnUser(userId)
        || isPlatformAdmin()
        || (
          resource.data.get('primaryInstitutionId', '') != ''
          && isInstitutionMember(resource.data.get('primaryInstitutionId', ''))
        )
        || (
          hasActiveStaff()
          && resource.data.get('teacherEmails', []) is list
          && email() in resource.data.get('teacherEmails', [])
        );

      allow create: if readsOwnUser(userId)
        && request.resource.data.get('uid', userId) == userId
        && (
          request.resource.data.get('email', '') == ''
          || sameEmail(request.resource.data.get('email', ''))
        )
        && selfProfileRoleIsTrusted(request.resource.data);

      allow update: if readsOwnUser(userId)
        && request.resource.data.get('uid', userId) == userId
        && (
          request.resource.data.get('email', '') == ''
          || sameEmail(request.resource.data.get('email', ''))
        )
        && (
          request.resource.data.get('role', 'student') == resource.data.get('role', 'student')
          || selfProfileRoleIsTrusted(request.resource.data)
        );

      allow create, update, delete: if isPlatformAdmin();

      // PASO 6: la memoria pedagógica puede ser leída por su dueño y por
      // personal autorizado. Toda escritura cliente queda denegada; el
      // backend seguro revalida el intento y usa Firebase Admin.
      match /learningEvents/{eventId} {
        allow get, list: if canReadPedagogicalUser(userId);
        allow create, update, delete: if false;
      }

      match /mastery/{conceptId} {
        allow get, list: if canReadPedagogicalUser(userId);
        allow create, update, delete: if false;
      }

      match /baselines/{baselineId} {
        allow get, list: if canReadPedagogicalUser(userId);
        allow create, update, delete: if false;
      }

      match /reviewSchedule/{conceptId} {
        allow get, list: if canReadPedagogicalUser(userId);
        allow create, update, delete: if false;
      }
    }

    match /staff/{staffEmail} {
      allow get: if isPlatformAdmin()
        || (signedIn() && staffEmail.lower() == email());
      allow list: if isPlatformAdmin();

      allow create, update: if isPlatformAdmin()
        || (
          request.resource.data.get('role', '') == 'teacher'
          && request.resource.data.get('active', false) == true
          && request.resource.data.get('email', '') is string
          && staffEmail.lower() == request.resource.data.get('email', '').lower()
          && isInstitutionManager(request.resource.data.get('institutionId', ''))
        );

      allow delete: if isPlatformAdmin();
    }

    match /institutions/{institutionId} {
      allow get, list: if isPlatformAdmin()
        || isInstitutionMember(institutionId)
        || isOwnSelfInstitution(institutionId);
      allow create: if (
          isPlatformAdmin()
          && institutionId.matches('^org__[A-Z0-9]{12}$')
          && request.resource.data.keys().hasOnly([
            'name', 'country', 'active', 'status', 'ownerUid',
            'organization', 'selfService', 'createdBy', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.get('ownerUid', '') is string
          && request.resource.data.get('ownerUid', '') != ''
          && request.resource.data.get('createdBy', '') == request.auth.uid
          && request.resource.data.get('organization', false) == true
          && request.resource.data.get('selfService', true) == false
          && request.resource.data.get('active', false) == true
          && request.resource.data.get('status', '') == 'active'
          && request.resource.data.get('name', '') is string
          && request.resource.data.get('name', '').size() >= 2
          && request.resource.data.get('name', '').size() <= 160
          && request.resource.data.get('country', '') is string
          && request.resource.data.get('country', '').size() <= 80
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
        )
        || (
          isOwnSelfInstitution(institutionId)
          && request.resource.data.keys().hasOnly([
            'name', 'country', 'active', 'status', 'ownerUid',
            'selfService', 'createdBy', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.get('ownerUid', '') == request.auth.uid
          && request.resource.data.get('createdBy', '') == request.auth.uid
          && request.resource.data.get('selfService', false) == true
          && request.resource.data.get('active', false) == true
          && request.resource.data.get('status', '') == 'active'
          && request.resource.data.get('name', '') is string
          && request.resource.data.get('name', '').size() >= 2
          && request.resource.data.get('name', '').size() <= 160
          && request.resource.data.get('country', '') is string
          && request.resource.data.get('country', '').size() <= 80
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
        );
      allow update: if isPlatformAdmin()
        || (
          ownsSelfInstitution(institutionId)
          && request.resource.data.get('ownerUid', '') == resource.data.get('ownerUid', '')
          && request.resource.data.get('selfService', false) == true
          && request.resource.data.get('active', false) == true
          && request.resource.data.get('status', '') == 'active'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'country', 'updatedAt'
          ])
          && request.resource.data.get('name', '') is string
          && request.resource.data.get('name', '').size() >= 2
          && request.resource.data.get('name', '').size() <= 160
          && request.resource.data.get('country', '') is string
          && request.resource.data.get('country', '').size() <= 80
          && request.resource.data.updatedAt == request.time
        );
      allow delete: if isPlatformAdmin();
    }

    match /institutionJoinCodes/{joinCodeId} {
      allow get: if signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
      allow list: if isPlatformAdmin()
        || isInstitutionManager(resource.data.get('institutionId', ''));

      allow create: if signedIn()
        && joinCodeId == 'code__' + request.resource.data.get('code', '')
        && request.resource.data.keys().hasOnly([
          'type', 'code', 'institutionId', 'institutionName', 'active',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.get('type', '') == 'institution_teacher_invite'
        && request.resource.data.get('code', '') is string
        && request.resource.data.get('code', '').matches('^GCI-[A-Z0-9]{6}$')
        && request.resource.data.get('institutionId', '') is string
        && request.resource.data.get('institutionId', '') != ''
        && request.resource.data.get('institutionName', '') is string
        && request.resource.data.get('institutionName', '').size() >= 2
        && request.resource.data.get('institutionName', '').size() <= 160
        && request.resource.data.get('active', false) == true
        && request.resource.data.get('createdBy', '') == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && (
          (
            exists(institutionPath(request.resource.data.get('institutionId', '')))
            && get(institutionPath(request.resource.data.get('institutionId', ''))).data.get('active', false) == true
            && get(institutionPath(request.resource.data.get('institutionId', ''))).data.get('selfService', false) != true
            && isInstitutionManager(request.resource.data.get('institutionId', ''))
          )
        );

      allow update: if isInstitutionManager(resource.data.get('institutionId', ''))
        && request.resource.data.get('type', '') == resource.data.get('type', '')
        && request.resource.data.get('code', '') == resource.data.get('code', '')
        && request.resource.data.get('institutionId', '') == resource.data.get('institutionId', '')
        && request.resource.data.get('institutionName', '') == resource.data.get('institutionName', '')
        && request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '')
        && request.resource.data.get('createdAt', request.time) == resource.data.get('createdAt', request.time)
        && request.resource.data.get('updatedBy', '') == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'active', 'updatedAt', 'updatedBy'
        ]);

      allow delete: if isPlatformAdmin()
        || isInstitutionManager(resource.data.get('institutionId', ''));
    }

    match /institutionMembers/{memberId} {
      allow get, list: if isPlatformAdmin()
        || sameEmail(resource.data.get('email', ''))
        || isInstitutionMember(resource.data.get('institutionId', ''))
        || (
          signedIn()
          && memberId == selfInstitutionId() + '__' + request.auth.uid
        );

      allow create: if (
          request.resource.data.get('organizationOwner', false) == true
          && memberId == request.resource.data.get('institutionId', '') + '__' + request.auth.uid
          && request.resource.data.get('role', '') == 'institution_manager'
          && request.resource.data.get('active', false) == true
          && getAfter(institutionPath(request.resource.data.get('institutionId', ''))).data.get('ownerUid', '') == request.auth.uid
        )
        || isPlatformAdmin()
        || (
          isInstitutionManager(request.resource.data.get('institutionId', ''))
          && request.resource.data.get('role', '') in ['teacher', 'institution_manager', 'student']
          && request.resource.data.get('active', false) == true
        )
        || (
          sameEmail(request.resource.data.get('email', ''))
          && request.resource.data.get('uid', '') == request.auth.uid
          && request.resource.data.get('claimedUid', '') == request.auth.uid
          && request.resource.data.get('active', false) == true
          && hasInviteMembership(request.resource.data.get('institutionId', ''))
          && get(inviteMembershipPath(request.resource.data.get('institutionId', ''))).data.get('role', '')
            == request.resource.data.get('role', '')
        )
        || (
          signedIn()
          && memberId == request.resource.data.get('institutionId', '') + '__' + request.auth.uid
          && request.resource.data.keys().hasOnly([
            'institutionId', 'uid', 'claimedUid', 'email', 'name', 'role',
            'active', 'joinedByCode', 'joinCode', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.get('uid', '') == request.auth.uid
          && request.resource.data.get('claimedUid', '') == request.auth.uid
          && sameEmail(request.resource.data.get('email', ''))
          && request.resource.data.get('name', '') is string
          && request.resource.data.get('name', '').size() >= 2
          && request.resource.data.get('name', '').size() <= 120
          && request.resource.data.get('role', '') == 'teacher'
          && request.resource.data.get('active', false) == true
          && request.resource.data.get('joinedByCode', false) == true
          && hasValidInstitutionJoinCode(
            request.resource.data.get('joinCode', ''),
            request.resource.data.get('institutionId', '')
          )
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
        )
        || (
          isOwnSelfInstitution(request.resource.data.get('institutionId', ''))
          && ownsSelfInstitution(request.resource.data.get('institutionId', ''))
          && memberId == request.resource.data.get('institutionId', '') + '__' + request.auth.uid
          && request.resource.data.keys().hasOnly([
            'institutionId', 'uid', 'claimedUid', 'email', 'name', 'role',
            'active', 'selfService', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.get('uid', '') == request.auth.uid
          && request.resource.data.get('claimedUid', '') == request.auth.uid
          && sameEmail(request.resource.data.get('email', ''))
          && request.resource.data.get('name', '') is string
          && request.resource.data.get('name', '').size() >= 2
          && request.resource.data.get('name', '').size() <= 120
          && request.resource.data.get('role', '') == 'institution_manager'
          && request.resource.data.get('active', false) == true
          && request.resource.data.get('selfService', false) == true
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
        );

      allow update: if isPlatformAdmin()
        || isInstitutionManager(resource.data.get('institutionId', ''))
        || (
          sameEmail(resource.data.get('email', ''))
          && request.resource.data.get('institutionId', '') == resource.data.get('institutionId', '')
          && request.resource.data.get('role', '') == resource.data.get('role', '')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'uid', 'claimedUid', 'email', 'active', 'updatedAt'
          ])
        );

      allow delete: if isPlatformAdmin()
        || isInstitutionManager(resource.data.get('institutionId', ''));
    }

    match /institutionalLeads/{leadId} {
      allow get: if isPlatformAdmin()
        || sameEmail(resource.data.get('email', ''));
      allow list, update, delete: if isPlatformAdmin();

      allow create: if signedInNonAnonymous()
        && sameEmail(request.resource.data.get('email', ''))
        && request.resource.data.keys().hasOnly([
          'name', 'email', 'organization', 'role', 'studentCount',
          'country', 'message', 'status', 'source', 'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 160
        && request.resource.data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && request.resource.data.organization is string
        && request.resource.data.organization.size() >= 2
        && request.resource.data.organization.size() <= 160
        && request.resource.data.role is string
        && request.resource.data.role.size() <= 80
        && request.resource.data.studentCount is number
        && request.resource.data.studentCount >= 0
        && request.resource.data.studentCount <= 100000
        && request.resource.data.country is string
        && request.resource.data.country.size() <= 80
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 1200
        && request.resource.data.status == 'new'
        && request.resource.data.source == 'GCA-GESA-01'
        && request.resource.data.createdAt == request.time;
    }

    match /groups/{groupId} {
      allow get, list: if isPlatformAdmin()
        || isInstitutionMember(resource.data.get('institutionId', ''))
        || isLegacyTeacherRecord(resource.data)
        || (
          signedIn()
          && resource.data.get('studentEmails', []) is list
          && email() in resource.data.get('studentEmails', [])
        )
        || isEnrolledIn(groupId);

      allow create: if (
          request.resource.data.get('institutionId', '') != ''
          && canTeach(request.resource.data.get('institutionId', ''))
        )
        || (
          request.resource.data.get('institutionId', '') == ''
          && hasActiveStaff()
        );

      allow update: if isPlatformAdmin()
        || (
          request.resource.data.get('institutionId', '') == resource.data.get('institutionId', '')
          && canTeach(resource.data.get('institutionId', ''))
        )
        || isLegacyTeacherRecord(resource.data);

      allow delete: if isPlatformAdmin();
    }

    match /enrollments/{enrollmentId} {
      allow get, list: if isPlatformAdmin()
        || isOwnStudentData(resource.data)
        || canTeach(resource.data.get('institutionId', ''))
        || isLegacyTeacherRecord(resource.data);

      allow create, update: if isPlatformAdmin()
        || canTeach(request.resource.data.get('institutionId', ''))
        || (
          isOwnStudentData(request.resource.data)
          && request.resource.data.get('studentId', '') == request.auth.uid
          && request.resource.data.get('inviteCode', '') is string
          && request.resource.data.get('inviteCode', '') != ''
          && exists(groupInvitePath(request.resource.data.get('inviteCode', '')))
          && get(groupInvitePath(request.resource.data.get('inviteCode', ''))).data.get('active', false) == true
          && get(groupInvitePath(request.resource.data.get('inviteCode', ''))).data.get('groupId', '')
            == request.resource.data.get('groupId', '')
          && get(groupInvitePath(request.resource.data.get('inviteCode', ''))).data.get('institutionId', '')
            == request.resource.data.get('institutionId', '')
        )
        || (
          request.resource.data.get('institutionId', '') == ''
          && hasActiveStaff()
        );

      allow delete: if isPlatformAdmin();
    }

    match /courseAccess/{accessId} {
      allow get: if signedIn()
        && (
          resource.data.get('type', '') == 'group_invite'
          || isOwnStudentData(resource.data)
          || canTeach(resource.data.get('institutionId', ''))
          || isLegacyTeacherRecord(resource.data)
        );
      allow list: if isPlatformAdmin();
      allow create, update: if isPlatformAdmin()
        || canTeach(request.resource.data.get('institutionId', ''))
        || (
          request.resource.data.get('institutionId', '') == ''
          && hasActiveStaff()
        );
      allow delete: if isPlatformAdmin();
    }

    match /assignments/{assignmentId} {
      allow get, list: if isPlatformAdmin()
        || canTeach(resource.data.get('institutionId', ''))
        || isOwnStudentData(resource.data)
        || (
          signedIn()
          && resource.data.get('studentEmails', []) is list
          && email() in resource.data.get('studentEmails', [])
        )
        || isEnrolledIn(resource.data.get('groupId', ''))
        || isLegacyTeacherRecord(resource.data);

      allow create, update: if isPlatformAdmin()
        || canTeach(request.resource.data.get('institutionId', ''))
        || (
          request.resource.data.get('institutionId', '') == ''
          && hasActiveStaff()
        );
      allow delete: if isPlatformAdmin();
    }

    match /progress/{progressId} {
      allow get, list: if isPlatformAdmin()
        || isOwnStudentData(resource.data)
        || canTeach(resource.data.get('institutionId', ''));
      allow create, update: if isPlatformAdmin()
        || isOwnStudentData(request.resource.data)
        || canTeach(request.resource.data.get('institutionId', ''));
      allow delete: if isPlatformAdmin();
    }

    match /assessments/{assessmentId} {
      allow get, list: if isPlatformAdmin()
        || isOwnStudentData(resource.data)
        || canTeach(resource.data.get('institutionId', ''));
      allow create: if isPlatformAdmin()
        || (
          request.resource.data.get('studentId', '') == request.auth.uid
          && sameEmail(request.resource.data.get('studentEmail', ''))
        )
        || canTeach(request.resource.data.get('institutionId', ''));
      allow update, delete: if isPlatformAdmin()
        || canTeach(resource.data.get('institutionId', ''));
    }

    match /academicActivities/{activityId} {
      allow get, list: if isPlatformAdmin()
        || canTeach(resource.data.get('institutionId', ''));

      allow create: if signedIn()
        && canTeach(request.resource.data.get('institutionId', ''))
        && request.resource.data.keys().hasOnly([
          'institutionId', 'ownerUid', 'activityType', 'title', 'content',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.get('ownerUid', '') == request.auth.uid
        && request.resource.data.get('activityType', '') in ['wheel', 'assessment']
        && request.resource.data.get('title', '') is string
        && request.resource.data.get('title', '').size() >= 2
        && request.resource.data.get('title', '').size() <= 120
        && request.resource.data.get('content', '') is string
        && request.resource.data.get('content', '').size() >= 1
        && request.resource.data.get('content', '').size() <= 8000
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if signedIn()
        && request.resource.data.get('institutionId', '') == resource.data.get('institutionId', '')
        && request.resource.data.get('ownerUid', '') == resource.data.get('ownerUid', '')
        && (
          resource.data.get('ownerUid', '') == request.auth.uid
          || isInstitutionManager(resource.data.get('institutionId', ''))
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'activityType', 'title', 'content', 'updatedAt'
        ])
        && request.resource.data.get('activityType', '') in ['wheel', 'assessment']
        && request.resource.data.get('title', '') is string
        && request.resource.data.get('title', '').size() >= 2
        && request.resource.data.get('title', '').size() <= 120
        && request.resource.data.get('content', '') is string
        && request.resource.data.get('content', '').size() >= 1
        && request.resource.data.get('content', '').size() <= 8000
        && request.resource.data.updatedAt == request.time;

      allow delete: if signedIn()
        && (
          resource.data.get('ownerUid', '') == request.auth.uid
          || isInstitutionManager(resource.data.get('institutionId', ''))
          || isPlatformAdmin()
        );
    }

    match /teacherTaskTemplates/{templateId} {
      allow get, list: if canReadTeacherTaskTemplate(resource.data);

      allow create: if signedInNonAnonymous()
        && isAcademicTeacher(request.resource.data.get('institutionId', ''))
        && request.resource.data.keys().hasOnly([
          'institutionId', 'ownerUid', 'template', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.get('ownerUid', '') == request.auth.uid
        && request.resource.data.get('template', {}) is map
        && request.resource.data.get('template', {}).keys().hasOnly([
          'schemaVersion', 'templateId', 'version', 'previousVersion',
          'ownerUserId', 'title', 'status', 'reusable', 'canPublish',
          'canAssign', 'masteryEligible', 'contentPolicy',
          'sourceFingerprint', 'review', 'cards'
        ])
        && request.resource.data.get('template', {}).get('schemaVersion', '')
          == 'NALVI-TEACHER-TASK-TEMPLATE-1'
        && request.resource.data.get('template', {}).get('templateId', '') is string
        && request.resource.data.get('template', {}).get('templateId', '') != ''
        && request.resource.data.get('template', {}).get('version', 0) is int
        && request.resource.data.get('template', {}).get('version', 0) >= 1
        && request.resource.data.get('template', {}).get('ownerUserId', '') == request.auth.uid
        && request.resource.data.get('template', {}).get('title', '') is string
        && request.resource.data.get('template', {}).get('title', '').size() >= 2
        && request.resource.data.get('template', {}).get('title', '').size() <= 160
        && request.resource.data.get('template', {}).get('status', '') in [
          'draft', 'needs_manual_review'
        ]
        && request.resource.data.get('template', {}).get('reusable', false) == true
        && request.resource.data.get('template', {}).get('canPublish', true) == false
        && request.resource.data.get('template', {}).get('canAssign', true) == false
        && request.resource.data.get('template', {}).get('masteryEligible', true) == false
        && request.resource.data.get('template', {}).get('contentPolicy', '')
          == 'exact-teacher-content-only'
        && request.resource.data.get('template', {}).get('sourceFingerprint', '') is string
        && request.resource.data.get('template', {}).get('sourceFingerprint', '').size() == 64
        && request.resource.data.get('template', {}).get('review', {}) is map
        && request.resource.data.get('template', {}).get('review', {}).get('required', false) == true
        && request.resource.data.get('template', {}).get('review', {}).get('items', []) is list
        && request.resource.data.get('template', {}).get('review', {}).get('items', []).size() <= 50
        && request.resource.data.get('template', {}).get('cards', []) is list
        && request.resource.data.get('template', {}).get('cards', []).size() >= 1
        && request.resource.data.get('template', {}).get('cards', []).size() <= 50
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if canReadTeacherTaskTemplate(resource.data)
        && request.resource.data.get('institutionId', '') == resource.data.get('institutionId', '')
        && request.resource.data.get('ownerUid', '') == resource.data.get('ownerUid', '')
        && request.resource.data.get('createdAt', request.time)
          == resource.data.get('createdAt', request.time)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'template', 'updatedAt'
        ])
        && request.resource.data.get('template', {}) is map
        && request.resource.data.get('template', {}).get('schemaVersion', '')
          == resource.data.get('template', {}).get('schemaVersion', '')
        && request.resource.data.get('template', {}).get('templateId', '')
          == resource.data.get('template', {}).get('templateId', '')
        && request.resource.data.get('template', {}).get('version', 0)
          == resource.data.get('template', {}).get('version', 0)
        && request.resource.data.get('template', {}).get('previousVersion', 0)
          == resource.data.get('template', {}).get('previousVersion', 0)
        && request.resource.data.get('template', {}).get('ownerUserId', '')
          == resource.data.get('template', {}).get('ownerUserId', '')
        && request.resource.data.get('template', {}).get('title', '')
          == resource.data.get('template', {}).get('title', '')
        && request.resource.data.get('template', {}).get('reusable', false) == true
        && request.resource.data.get('template', {}).get('masteryEligible', true) == false
        && request.resource.data.get('template', {}).get('contentPolicy', '')
          == resource.data.get('template', {}).get('contentPolicy', '')
        && request.resource.data.get('template', {}).get('sourceFingerprint', '')
          == resource.data.get('template', {}).get('sourceFingerprint', '')
        && request.resource.data.get('template', {}).get('review', {})
          == resource.data.get('template', {}).get('review', {})
        && request.resource.data.get('template', {}).get('cards', [])
          == resource.data.get('template', {}).get('cards', [])
        && request.resource.data.get('template', {}).diff(
          resource.data.get('template', {})
        ).affectedKeys().hasOnly(['status', 'canPublish', 'canAssign'])
        && request.resource.data.get('template', {}).get('status', '') in [
          'approved', 'archived'
        ]
        && (
          (
            request.resource.data.get('template', {}).get('status', '') == 'approved'
            && request.resource.data.get('template', {}).get('canPublish', false) == true
            && request.resource.data.get('template', {}).get('canAssign', false) == true
          )
          || (
            request.resource.data.get('template', {}).get('status', '') == 'archived'
            && request.resource.data.get('template', {}).get('canPublish', true) == false
            && request.resource.data.get('template', {}).get('canAssign', true) == false
          )
        )
        && request.resource.data.updatedAt == request.time;

      allow delete: if canReadTeacherTaskTemplate(resource.data);
    }

    match /teacherTaskAssignments/{assignmentId} {
      allow get, list: if signedInNonAnonymous()
        && (
          isPlatformAdmin()
          || canManageAcademicGroup(
            resource.data.get('groupId', ''),
            resource.data.get('institutionId', '')
          )
          || hasActiveAcademicEnrollment(
            resource.data.get('groupId', ''),
            resource.data.get('institutionId', '')
          )
        );

      allow create: if signedInNonAnonymous()
        && request.resource.data.keys().hasOnly([
          'institutionId', 'groupId', 'templateDocumentId',
          'templateId', 'templateVersion', 'sourceFingerprint', 'cardsSnapshot',
          'assignedByUid', 'title', 'instructions', 'status',
          'assignedAt', 'dueAt'
        ])
        && canManageAcademicGroup(
          request.resource.data.get('groupId', ''),
          request.resource.data.get('institutionId', '')
        )
        && request.resource.data.get('assignedByUid', '') == request.auth.uid
        && request.resource.data.get('templateDocumentId', '') is string
        && request.resource.data.get('templateDocumentId', '') != ''
        && request.resource.data.get('templateId', '') is string
        && request.resource.data.get('templateId', '') != ''
        && exists(teacherTaskTemplatePath(request.resource.data.get('templateDocumentId', '')))
        && get(teacherTaskTemplatePath(request.resource.data.get('templateDocumentId', ''))).data.get('institutionId', '')
          == request.resource.data.get('institutionId', '')
        && canReadTeacherTaskTemplate(
          get(teacherTaskTemplatePath(request.resource.data.get('templateDocumentId', ''))).data
        )
        && get(teacherTaskTemplatePath(request.resource.data.get('templateDocumentId', ''))).data.get('template', {}).get('status', '')
          == 'approved'
        && get(teacherTaskTemplatePath(request.resource.data.get('templateDocumentId', ''))).data.get('template', {}).get('canAssign', false)
          == true
        && request.resource.data.get('templateId', '')
          == get(teacherTaskTemplatePath(request.resource.data.get('templateDocumentId', ''))).data.get('template', {}).get('templateId', '')
        && request.resource.data.get('templateVersion', 0)
          == get(teacherTaskTemplatePath(request.resource.data.get('templateDocumentId', ''))).data.get('template', {}).get('version', 0)
        && request.resource.data.get('sourceFingerprint', '')
          == get(teacherTaskTemplatePath(request.resource.data.get('templateDocumentId', ''))).data.get('template', {}).get('sourceFingerprint', '')
        && request.resource.data.get('cardsSnapshot', [])
          == get(teacherTaskTemplatePath(request.resource.data.get('templateDocumentId', ''))).data.get('template', {}).get('cards', [])
        && request.resource.data.get('title', '') is string
        && request.resource.data.get('title', '').size() >= 2
        && request.resource.data.get('title', '').size() <= 160
        && request.resource.data.get('instructions', '') is string
        && request.resource.data.get('instructions', '').size() <= 1200
        && request.resource.data.get('status', '') == 'assigned'
        && request.resource.data.assignedAt == request.time
        && (
          request.resource.data.get('dueAt', null) == null
          || request.resource.data.get('dueAt', null) is timestamp
        );

      allow update: if false;
      allow delete: if signedInNonAnonymous()
        && canManageAcademicGroup(
          resource.data.get('groupId', ''),
          resource.data.get('institutionId', '')
        );
    }

    match /teacherTaskSubmissions/{submissionId} {
      allow get, list: if signedInNonAnonymous()
        && (
          isPlatformAdmin()
          || resource.data.get('studentId', '') == request.auth.uid
          || canManageAcademicGroup(
            resource.data.get('groupId', ''),
            resource.data.get('institutionId', '')
          )
        );

      allow create, update: if validOwnTaskSubmission(
          submissionId,
          request.resource.data
        )
        && request.resource.data.keys().hasOnly([
          'institutionId', 'groupId', 'assignmentId', 'studentId',
          'studentName', 'status', 'correctCount', 'totalCount',
          'answers', 'updatedAt', 'completedAt'
        ])
        && request.resource.data.get('status', '') in ['in_progress', 'completed']
        && request.resource.data.get('correctCount', -1) is int
        && request.resource.data.get('correctCount', -1) >= 0
        && request.resource.data.get('totalCount', -1) is int
        && request.resource.data.get('totalCount', -1) >= 0
        && request.resource.data.get('totalCount', -1) <= 50
        && request.resource.data.get('correctCount', -1)
          <= request.resource.data.get('totalCount', -1)
        && request.resource.data.get('answers', []) is list
        && request.resource.data.get('answers', []).size()
          == request.resource.data.get('totalCount', -1)
        && request.resource.data.updatedAt == request.time
        && (
          (
            request.resource.data.get('status', '') == 'in_progress'
            && request.resource.data.get('completedAt', null) == null
          )
          || (
            request.resource.data.get('status', '') == 'completed'
            && request.resource.data.completedAt == request.time
          )
        )
        && (
          resource == null
          || (
            request.resource.data.get('institutionId', '') == resource.data.get('institutionId', '')
            && request.resource.data.get('groupId', '') == resource.data.get('groupId', '')
            && request.resource.data.get('assignmentId', '') == resource.data.get('assignmentId', '')
            && request.resource.data.get('studentId', '') == resource.data.get('studentId', '')
            && request.resource.data.get('studentName', '') == resource.data.get('studentName', '')
          )
        );

      allow delete: if isPlatformAdmin()
        || canManageAcademicGroup(
          resource.data.get('groupId', ''),
          resource.data.get('institutionId', '')
        );
    }

    match /academicTeacherChannels/{institutionId} {
      allow get, list: if isOrganizationInstitution(institutionId)
        && isAcademicTeacher(institutionId);

      allow create: if isOrganizationInstitution(institutionId)
        && isAcademicTeacher(institutionId)
        && request.resource.data.keys().hasOnly([
          'institutionId', 'channelType', 'createdBy', 'createdAt'
        ])
        && request.resource.data.get('institutionId', '') == institutionId
        && request.resource.data.get('channelType', '') == 'institution_teachers'
        && request.resource.data.get('createdBy', '') == request.auth.uid
        && request.resource.data.createdAt == request.time;

      allow update: if false;
      allow delete: if isPlatformAdmin()
        || isAcademicManager(institutionId);

      match /messages/{messageId} {
        allow get, list: if isOrganizationInstitution(institutionId)
          && isAcademicTeacher(institutionId);

        allow create: if isOrganizationInstitution(institutionId)
          && isAcademicTeacher(institutionId)
          && request.resource.data.keys().hasOnly([
            'institutionId', 'authorId', 'authorName', 'body',
            'createdAt', 'updatedAt'
          ])
          && request.resource.data.get('institutionId', '') == institutionId
          && validOwnAcademicAuthorship(request.resource.data)
          && request.resource.data.get('body', '') is string
          && request.resource.data.get('body', '').size() >= 1
          && request.resource.data.get('body', '').size() <= 1200
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if isOrganizationInstitution(institutionId)
          && isAcademicTeacher(institutionId)
          && resource.data.get('authorId', '') == request.auth.uid
          && request.resource.data.get('institutionId', '') == institutionId
          && request.resource.data.get('authorId', '') == resource.data.get('authorId', '')
          && request.resource.data.get('authorName', '') == resource.data.get('authorName', '')
          && request.resource.data.get('createdAt', request.time)
            == resource.data.get('createdAt', request.time)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'body', 'updatedAt'
          ])
          && request.resource.data.get('body', '') is string
          && request.resource.data.get('body', '').size() >= 1
          && request.resource.data.get('body', '').size() <= 1200
          && request.resource.data.updatedAt == request.time;

        allow delete: if isOrganizationInstitution(institutionId)
          && isAcademicTeacher(institutionId)
          && (
            resource.data.get('authorId', '') == request.auth.uid
            || isAcademicManager(institutionId)
            || isPlatformAdmin()
          );
      }
    }

    match /academicPosts/{postId} {
      allow get, list: if canReadAcademicPost(resource.data);

      allow create: if validOwnAcademicAuthorship(request.resource.data)
        && validAcademicPostScope(request.resource.data)
        && request.resource.data.keys().hasOnly([
          'institutionId', 'groupId', 'audience', 'postType',
          'authorId', 'authorName', 'title', 'body', 'status',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.get('postType', '') in ['question', 'activity']
        && request.resource.data.get('title', '') is string
        && request.resource.data.get('title', '').size() <= 160
        && request.resource.data.get('body', '') is string
        && request.resource.data.get('body', '').size() >= 1
        && request.resource.data.get('body', '').size() <= 4000
        && request.resource.data.get('status', '') == 'published'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if signedInNonAnonymous()
        && resource.data.get('authorId', '') == request.auth.uid
        && validAcademicPostScope(resource.data)
        && request.resource.data.get('institutionId', '') == resource.data.get('institutionId', '')
        && request.resource.data.get('groupId', '') == resource.data.get('groupId', '')
        && request.resource.data.get('audience', '') == resource.data.get('audience', '')
        && request.resource.data.get('postType', '') == resource.data.get('postType', '')
        && request.resource.data.get('authorId', '') == resource.data.get('authorId', '')
        && request.resource.data.get('authorName', '') == resource.data.get('authorName', '')
        && request.resource.data.get('status', '') == resource.data.get('status', '')
        && request.resource.data.get('createdAt', request.time)
          == resource.data.get('createdAt', request.time)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'body', 'updatedAt'
        ])
        && request.resource.data.get('title', '') is string
        && request.resource.data.get('title', '').size() <= 160
        && request.resource.data.get('body', '') is string
        && request.resource.data.get('body', '').size() >= 1
        && request.resource.data.get('body', '').size() <= 4000
        && request.resource.data.updatedAt == request.time;

      allow delete: if signedInNonAnonymous()
        && canReadAcademicPost(resource.data)
        && (
          resource.data.get('authorId', '') == request.auth.uid
          || isAcademicManager(resource.data.get('institutionId', ''))
          || isPlatformAdmin()
        );

      match /replies/{replyId} {
        allow get, list: if exists(academicPostPath(postId))
          && canReadAcademicPost(get(academicPostPath(postId)).data);

        allow create: if exists(academicPostPath(postId))
          && canReadAcademicPost(get(academicPostPath(postId)).data)
          && validOwnAcademicAuthorship(request.resource.data)
          && request.resource.data.keys().hasOnly([
            'authorId', 'authorName', 'body', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.get('body', '') is string
          && request.resource.data.get('body', '').size() >= 1
          && request.resource.data.get('body', '').size() <= 1000
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if exists(academicPostPath(postId))
          && canReadAcademicPost(get(academicPostPath(postId)).data)
          && resource.data.get('authorId', '') == request.auth.uid
          && request.resource.data.get('authorId', '') == resource.data.get('authorId', '')
          && request.resource.data.get('authorName', '') == resource.data.get('authorName', '')
          && request.resource.data.get('createdAt', request.time)
            == resource.data.get('createdAt', request.time)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'body', 'updatedAt'
          ])
          && request.resource.data.get('body', '') is string
          && request.resource.data.get('body', '').size() >= 1
          && request.resource.data.get('body', '').size() <= 1000
          && request.resource.data.updatedAt == request.time;

        allow delete: if signedInNonAnonymous()
          && exists(academicPostPath(postId))
          && canReadAcademicPost(get(academicPostPath(postId)).data)
          && (
            resource.data.get('authorId', '') == request.auth.uid
            || isPlatformAdmin()
            || get(academicPostPath(postId)).data.get('authorId', '') == request.auth.uid
            || isAcademicManager(
              get(academicPostPath(postId)).data.get('institutionId', '')
            )
          );
      }
    }

    match /certificateRequests/{requestId} {
      allow get, list: if isPlatformAdmin()
        || isOwnStudentData(resource.data)
        || canTeach(resource.data.get('institutionId', ''))
        || isLegacyTeacherRecord(resource.data);

      allow create: if signedIn()
        && isOwnStudentData(request.resource.data)
        && request.resource.data.get('status', '') == 'pending';

      allow update: if isPlatformAdmin()
        || canTeach(resource.data.get('institutionId', ''))
        || isLegacyTeacherRecord(resource.data);
      allow delete: if isPlatformAdmin();
    }

    match /certificates/{certificateId} {
      allow get, list: if isPlatformAdmin()
        || isOwnStudentData(resource.data)
        || canTeach(resource.data.get('institutionId', ''))
        || isLegacyTeacherRecord(resource.data);
      allow create, update: if isPlatformAdmin()
        || canTeach(request.resource.data.get('institutionId', ''))
        || (
          request.resource.data.get('institutionId', '') == ''
          && hasActiveStaff()
        );
      allow delete: if isPlatformAdmin();
    }

    match /certificatePublic/{certificateId} {
      allow get: if resource.data.get('code', '') == certificateId
        && resource.data.get('status', '') in ['approved', 'issued', 'active'];
      allow list: if false;
      allow create, update: if isPlatformAdmin()
        || (
          canTeach(request.resource.data.get('institutionId', ''))
          && request.resource.data.keys().hasOnly([
            'studentName', 'course', 'hours', 'code', 'status',
            'approvedByName', 'institutionId', 'approvedAt', 'createdAt'
          ])
          && request.resource.data.get('code', '') == certificateId
          && request.resource.data.get('status', '') == 'approved'
        );
      allow delete: if isPlatformAdmin();
    }

    match /liveClassrooms/{pin} {
      allow get: if signedIn();
      allow list: if isPlatformAdmin()
        || canTeach(resource.data.get('institutionId', ''))
        || isLegacyTeacherRecord(resource.data);

      allow create: if signedIn()
        && request.resource.data.get('hostUid', '') == request.auth.uid
        && (
          canTeach(request.resource.data.get('institutionId', ''))
          || (
            request.resource.data.get('institutionId', '') == ''
            && hasActiveStaff()
          )
        );

      allow update: if isPlatformAdmin()
        || (
          signedIn()
          && resource.data.get('hostUid', '') == request.auth.uid
          && request.resource.data.get('hostUid', '') == resource.data.get('hostUid', '')
        );
      allow delete: if isPlatformAdmin()
        || (signedIn() && resource.data.get('hostUid', '') == request.auth.uid);

      match /players/{playerId} {
        allow get, list: if signedIn();
        allow create, update: if signedIn()
          && request.auth.uid == playerId
          && request.resource.data.get('uid', playerId) == playerId
          && request.resource.data.get('name', '') is string
          && request.resource.data.get('name', '').size() >= 1
          && request.resource.data.get('name', '').size() <= 28
          && request.resource.data.get('score', 0) is number
          && request.resource.data.get('score', 0) >= 0
          && request.resource.data.get('correct', 0) is number
          && request.resource.data.get('correct', 0) >= 0;
        allow delete: if isPlatformAdmin()
          || (signedIn() && request.auth.uid == playerId)
          || (
            signedIn()
            && get(/databases/$(database)/documents/liveClassrooms/$(pin)).data.get('hostUid', '')
              == request.auth.uid
          );
      }
    }

    // COMUNIDAD NALVI. Esta sección se inserta antes del cierre fail-closed.
    // Cualquier visitante puede leer la Comunidad. Solo una cuenta real de NALVI
    // (no una sesión anónima) puede publicar, responder, reaccionar o registrar vista.

    function isCommunityMember() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function communityPhoto() {
      return isCommunityMember()
        ? request.auth.token.get('picture', '')
        : '';
    }

    function validCommunityCategory(value) {
      return value is string
        && value in ['announcements', 'questions', 'community', 'learning'];
    }

    function validCommunityText(value, maximum) {
      return value is string && value.size() >= 1 && value.size() <= maximum;
    }

    function validCommunityPhoto(value) {
      return value is string
        && value.size() <= 500
        && value == communityPhoto();
    }

    function communityProfilePath(userId) {
      return /databases/$(database)/documents/communityProfiles/$(userId);
    }

    match /communityProfiles/{userId} {
      allow get, list: if true;

      allow create: if isCommunityMember()
        && userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'userId', 'displayName', 'photoURL', 'bio', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'userId', 'displayName', 'photoURL', 'bio', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && validCommunityText(request.resource.data.displayName, 80)
        && validCommunityPhoto(request.resource.data.photoURL)
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 160
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // El administrador puede crear solamente la ficha pública mínima de una
      // cuenta registrada. No puede copiar correo, progreso ni datos privados.
      allow create: if isPlatformAdmin()
        && exists(userProfilePath(userId))
        && request.resource.data.keys().hasOnly([
          'userId', 'displayName', 'photoURL', 'bio', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'userId', 'displayName', 'photoURL', 'bio', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.userId == userId
        && validCommunityText(request.resource.data.displayName, 80)
        && request.resource.data.displayName
          == get(userProfilePath(userId)).data.get('displayName', '')
        && request.resource.data.photoURL == ''
        && request.resource.data.bio == ''
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isCommunityMember()
        && userId == request.auth.uid
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'photoURL', 'bio', 'updatedAt'
        ])
        && validCommunityText(request.resource.data.displayName, 80)
        && validCommunityPhoto(request.resource.data.photoURL)
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 160
        && request.resource.data.updatedAt == request.time;

      allow delete: if isPlatformAdmin();

      match /followers/{followerId} {
        allow get, list: if true;
        allow create: if isCommunityMember()
          && followerId == request.auth.uid
          && userId != request.auth.uid
          && exists(/databases/$(database)/documents/communityProfiles/$(userId))
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.keys().hasAll(['createdAt'])
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isCommunityMember() && followerId == request.auth.uid;
        allow delete: if isPlatformAdmin();
      }
    }

    function isConversationParticipant(data) {
      return isCommunityMember()
        && data.get('participantIds', []) is list
        && data.get('participantIds', []).size() == 2
        && request.auth.uid in data.get('participantIds', []);
    }

    function validConversationParticipants(data) {
      return isConversationParticipant(data)
        && data.participantIds[0] is string
        && data.participantIds[1] is string
        && data.participantIds[0] != data.participantIds[1]
        && exists(communityProfilePath(data.participantIds[0]))
        && exists(communityProfilePath(data.participantIds[1]));
    }

    function validConversationReadReceiptUpdate() {
      let nextReadAt = request.resource.data.get('readAtBy', {});
      let previousReadAt = resource.data.get('readAtBy', {});
      return nextReadAt is map
        && previousReadAt is map
        && nextReadAt.size() <= 2
        && nextReadAt.keys().hasOnly(request.resource.data.participantIds)
        && nextReadAt.diff(previousReadAt).affectedKeys().hasOnly([request.auth.uid])
        && nextReadAt.get(request.auth.uid, null) == request.time;
    }

    match /communityConversations/{conversationId} {
      allow get: if isConversationParticipant(resource.data);
      allow list: if isCommunityMember()
        && request.auth.uid in resource.data.participantIds;

      allow create: if validConversationParticipants(request.resource.data)
        && request.resource.data.keys().hasOnly([
          'participantIds', 'lastMessage', 'lastSenderId', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'participantIds', 'lastMessage', 'lastSenderId', 'updatedAt'
        ])
        && validCommunityText(request.resource.data.lastMessage, 500)
        && request.resource.data.lastSenderId == request.auth.uid
        && (!('createdAt' in request.resource.data) || request.resource.data.createdAt == request.time)
        && request.resource.data.updatedAt == request.time;

      allow update: if isConversationParticipant(resource.data)
        && validConversationParticipants(request.resource.data)
        && request.resource.data.participantIds == resource.data.participantIds
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'lastMessage', 'lastSenderId', 'updatedAt'
            ])
            && validCommunityText(request.resource.data.lastMessage, 500)
            && request.resource.data.lastSenderId == request.auth.uid
            && request.resource.data.updatedAt == request.time
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAtBy'])
            && validConversationReadReceiptUpdate()
          )
        );

      allow delete: if isPlatformAdmin();

      match /messages/{messageId} {
        allow get, list: if isConversationParticipant(
          get(/databases/$(database)/documents/communityConversations/$(conversationId)).data
        );

        allow create: if isCommunityMember()
          && isConversationParticipant(
            getAfter(/databases/$(database)/documents/communityConversations/$(conversationId)).data
          )
          && request.resource.data.keys().hasOnly(['authorId', 'body', 'createdAt'])
          && request.resource.data.keys().hasAll(['authorId', 'body', 'createdAt'])
          && request.resource.data.authorId == request.auth.uid
          && validCommunityText(request.resource.data.body, 500)
          && request.resource.data.createdAt == request.time;

        allow update: if false;
        allow delete: if isCommunityMember()
          && resource.data.authorId == request.auth.uid
          && isConversationParticipant(
            get(/databases/$(database)/documents/communityConversations/$(conversationId)).data
          );
        allow delete: if isPlatformAdmin();
      }
    }

    match /communityPosts/{postId} {
      allow get, list: if true;

      allow create: if isCommunityMember()
        && request.resource.data.keys().hasOnly([
          'authorId', 'authorName', 'body', 'category', 'pinned', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'authorId', 'authorName', 'body', 'category', 'pinned', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.authorId == request.auth.uid
        && validCommunityText(request.resource.data.authorName, 80)
        && exists(communityProfilePath(request.auth.uid))
        && request.resource.data.authorName == get(communityProfilePath(request.auth.uid)).data.displayName
        && validCommunityText(request.resource.data.body, 700)
        && validCommunityCategory(request.resource.data.category)
        && (
          request.resource.data.category != 'announcements'
          || isPlatformAdmin()
        )
        && request.resource.data.pinned == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isCommunityMember()
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.authorName == resource.data.authorName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.pinned == resource.data.pinned
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'body', 'category', 'updatedAt'
        ])
        && validCommunityText(request.resource.data.body, 700)
        && validCommunityCategory(request.resource.data.category)
        && request.resource.data.category != 'announcements'
        && request.resource.data.updatedAt == request.time;

      allow delete: if isCommunityMember()
        && resource.data.authorId == request.auth.uid;
      allow delete: if isPlatformAdmin();

      match /comments/{commentId} {
        allow get, list: if true;
        allow create: if isCommunityMember()
          && request.resource.data.keys().hasOnly([
            'authorId', 'authorName', 'body', 'parentCommentId', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.keys().hasAll([
            'authorId', 'authorName', 'body', 'parentCommentId', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.authorId == request.auth.uid
          && validCommunityText(request.resource.data.authorName, 80)
          && exists(communityProfilePath(request.auth.uid))
          && request.resource.data.authorName == get(communityProfilePath(request.auth.uid)).data.displayName
          && validCommunityText(request.resource.data.body, 500)
          && request.resource.data.parentCommentId is string
          && request.resource.data.parentCommentId.size() <= 120
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if isCommunityMember()
          && resource.data.authorId == request.auth.uid
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.authorName == resource.data.authorName
          && request.resource.data.parentCommentId == resource.data.parentCommentId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'body', 'updatedAt'
          ])
          && validCommunityText(request.resource.data.body, 500)
          && request.resource.data.updatedAt == request.time;
        allow delete: if isCommunityMember()
          && resource.data.authorId == request.auth.uid;
        allow delete: if isPlatformAdmin();
      }

      match /reactions/{userId} {
        allow get, list: if true;
        allow create: if isCommunityMember()
          && userId == request.auth.uid
          && request.resource.data.keys().hasOnly(['type', 'createdAt'])
          && request.resource.data.keys().hasAll(['type', 'createdAt'])
          && request.resource.data.type == 'like'
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isCommunityMember() && userId == request.auth.uid;
        allow delete: if isPlatformAdmin();
      }

      match /views/{userId} {
        allow get, list: if true;
        allow create: if isCommunityMember()
          && userId == request.auth.uid
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.keys().hasAll(['createdAt'])
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isPlatformAdmin();
      }
    }

    // Cualquier colección no declarada queda denegada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
